# Optional live GitHub App read-only discovery. Do not commit a real .env file.
AGENTCONSTRUCT_GITHUB_APP_READ_ONLY=false
AGENTCONSTRUCT_GITHUB_APP_ID=
AGENTCONSTRUCT_GITHUB_APP_INSTALLATION_ID=
AGENTCONSTRUCT_GITHUB_APP_KEY_HOST_PATH=

# AWS Quick Create and server-side read-only verification. Keep values out of Git.
AGENTCONSTRUCT_CONTROL_PLANE_ROLE_ARN=
AGENTCONSTRUCT_AWS_CONNECTION_TEMPLATE_URL=
AGENTCONSTRUCT_AWS_LIVE_DISCOVERY_ENABLED=false

# Connection ExternalIds are never held by the browser. Use aws_secrets_manager in a
# deployed control plane; local_encrypted is a local-only deterministic substitute.
AGENTCONSTRUCT_CONNECTION_SECRET_BACKEND=local_encrypted
AGENTCONSTRUCT_CONNECTION_SECRET_KEY=
AGENTCONSTRUCT_CONNECTION_SECRET_PREFIX=agentconstruct/customer-connections

# External-provider activation (all safe defaults; no external call is made until
# a later adapter is explicitly enabled). Use Google Workspace for your team and
# Cognito for customer identities when accounts are ready.
AGENTCONSTRUCT_IDENTITY_PROVIDER=local
AGENTCONSTRUCT_GOOGLE_WORKSPACE_DOMAIN=
AGENTCONSTRUCT_OIDC_ISSUER=
AGENTCONSTRUCT_OIDC_AUDIENCE=
AGENTCONSTRUCT_JWKS_URL=
AGENTCONSTRUCT_COGNITO_USER_POOL_ID=
AGENTCONSTRUCT_COGNITO_APP_CLIENT_ID=

# Keep email disabled until a verified sending domain and provider account exist.
AGENTCONSTRUCT_EMAIL_PROVIDER=disabled
AGENTCONSTRUCT_GMAIL_SENDER=
AGENTCONSTRUCT_SES_REGION=

# Keep billing manual during the invite-only beta; Stripe keys belong in the
# deployer's secret manager, never this file or Git.
AGENTCONSTRUCT_BILLING_PROVIDER=manual
AGENTCONSTRUCT_STRIPE_WEBHOOK_SECRET=
AGENTCONSTRUCT_ANALYTICS_PROVIDER=local

# Exact browser origins allowed to call the API. Use comma-separated HTTPS
# origins in hosted environments. Wildcards, paths and public HTTP origins fail
# closed. Localhost HTTP is accepted only for development.
AGENTCONSTRUCT_ALLOWED_FRONTEND_ORIGINS=http://localhost:5173

# Amazon Nova 2 Lite through Bedrock. The fixture remains the safe local default.
# Enabling Bedrock uses the normal AWS SDK role/credential chain; never add access
# keys to this file. `us.` keeps inference within the US geography.
AGENTCONSTRUCT_MODEL_PROVIDER=fixture
AGENTCONSTRUCT_MODEL_FALLBACK=disabled
AGENTCONSTRUCT_BEDROCK_REGION=us-east-1
AGENTCONSTRUCT_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
AGENTCONSTRUCT_MODEL_DATA_POLICY=bedrock-no-training
AGENTCONSTRUCT_MODEL_MAX_OUTPUT_TOKENS=2000
AGENTCONSTRUCT_MODEL_TIMEOUT_SECONDS=60
AGENTCONSTRUCT_MODEL_CONNECT_TIMEOUT_SECONDS=5
AGENTCONSTRUCT_MODEL_MAX_ATTEMPTS=2

# Optional audited pricing inputs. Set both rates and a catalog version together
# from the current Bedrock pricing page; unset values produce no cost claim.
AGENTCONSTRUCT_NOVA_INPUT_PRICE_PER_MILLION_USD=
AGENTCONSTRUCT_NOVA_OUTPUT_PRICE_PER_MILLION_USD=
AGENTCONSTRUCT_NOVA_PRICING_CATALOG_VERSION=
