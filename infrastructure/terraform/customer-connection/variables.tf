variable "region" {
  type        = string
  description = "Customer AWS region used for the identity-only connection setup."
}

variable "project" {
  type        = string
  default     = "agentconstruct"
  description = "Ownership tag value."
}

variable "customer_connection_id" {
  type        = string
  description = "Non-secret AgentConstruct connection ID; it isolates role names and Terraform state."

  validation {
    condition     = can(regex("^[a-z0-9-]{3,48}$", var.customer_connection_id))
    error_message = "customer_connection_id must be 3-48 lowercase letters, digits, or hyphens."
  }
}

variable "agentconstruct_control_plane_role_arn" {
  type        = string
  description = "Future AgentConstruct control-plane IAM role allowed to assume the customer roles."

  validation {
    condition     = can(regex("^arn:aws:iam::[0-9]{12}:role/.+", var.agentconstruct_control_plane_role_arn))
    error_message = "agentconstruct_control_plane_role_arn must be an IAM role ARN."
  }
}

variable "external_id" {
  type        = string
  sensitive   = true
  description = "Per-connection secret generated by AgentConstruct and supplied outside Git."

  validation {
    condition     = length(var.external_id) >= 24
    error_message = "external_id must be at least 24 characters."
  }
}
